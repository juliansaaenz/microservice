<?xml version="1.0" encoding="UTF-8"?>
<!-- Hace que el botón Run de NetBeans ejecute "mvn spring-boot:run" -->
<actions>
    <action>
        <actionName>run</actionName>
        <packagings><packaging>jar</packaging></packagings>
        <goals><goal>spring-boot:run</goal></goals>
    </action>
    <action>
        <actionName>debug</actionName>
        <packagings><packaging>jar</packaging></packagings>
        <goals><goal>spring-boot:run</goal></goals>
        <properties>
            <spring-boot.run.jvmArguments>-agentlib:jdwp=transport=dt_socket,server=n,address=${jpda.address}</spring-boot.run.jvmArguments>
            <jpda.listen>true</jpda.listen>
        </properties>
    </action>
</actions>
